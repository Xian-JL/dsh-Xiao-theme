{
  "name": "dsh-xiao-theme",
  "version": "1.1.0",
  "description": "Xiao \u00b7 Vigil of the Azure Sky: selectable character artworks, amplified motion, a draggable Xiao companion, and optional official DeepSeek balance monitoring.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_ASSETS.md",
    "docs/DESIGN_AND_MOTION.md",
    "docs/COMPATIBILITY.md",
    "docs/VALIDATION.md",
    "docs/V2_OPTIMIZATION.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "assets": "python scripts/extract-assets.py",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:settings": "node scripts/test-settings.mjs",
    "test:session": "node scripts/test-session-state.mjs",
    "test:companion": "node scripts/test-companion.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:balance": "node scripts/test-balance.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:bundles": "node scripts/test-bundles.mjs",
    "verify": "npm run build && npm run check && npm run test:settings && npm run test:session && npm run test:companion && npm run test:motion && npm run test:balance && npm run test:lifecycle && npm run test:bundles",
    "setup": "npm install --omit=dev"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "xiao",
    "yaksha",
    "azure-sky",
    "web"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "Xian-JL (LiqWhisper)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xian-JL/dsh-Xiao-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Xian-JL/dsh-Xiao-theme/issues"
  },
  "homepage": "https://github.com/Xian-JL/dsh-Xiao-theme#readme",
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
